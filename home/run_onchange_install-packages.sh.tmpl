#!/usr/bin/env bash
# Detect OS family + profile, install packages via system manager,
# fall back to release binaries for tools that aren't packaged or are too old.

set -euo pipefail

PROFILE="{{ .profile }}"
WITH_SUDO=""
if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    WITH_SUDO="sudo"
fi

# Detect package manager.
PKG_MGR=""
if   command -v apt-get >/dev/null 2>&1; then PKG_MGR="apt"
elif command -v dnf     >/dev/null 2>&1; then PKG_MGR="dnf"
elif command -v apk     >/dev/null 2>&1; then PKG_MGR="apk"
fi

{{- /* ---- apt path (Ubuntu/Debian) ---- */ -}}
{{- if true }}
# Returns 0 if any package in "$@" is NOT installed (i.e., we need to call apt).
apt_needs_install() {
    local p
    for p in "$@"; do
        dpkg -s "$p" >/dev/null 2>&1 || return 0
    done
    return 1
}

install_apt() {
    local common_pkgs=(
{{- range (index .apt "common") }}
        "{{ . }}"
{{- end }}
    )
    local extra_pkgs=(
{{- range (index .apt $.profile) }}
        "{{ . }}"
{{- end }}
    )
    if ! apt_needs_install "${common_pkgs[@]}" "${extra_pkgs[@]}"; then
        echo "apt: all packages already installed; skipping sudo apt-get"
        return 0
    fi
    if [ -z "$WITH_SUDO" ] && [ "$(id -u)" -ne 0 ]; then
        echo "apt: missing packages but no sudo available; skipping (install manually):" >&2
        for p in "${common_pkgs[@]}" "${extra_pkgs[@]}"; do dpkg -s "$p" >/dev/null 2>&1 || echo "  - $p" >&2; done
        return 0
    fi
    $WITH_SUDO apt-get update -qq
    # Common packages — strict; missing means broken setup.
    if apt_needs_install "${common_pkgs[@]}"; then
        $WITH_SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y "${common_pkgs[@]}"
    fi

    # Generate en_US.UTF-8 if it's not already available — fresh Ubuntu minimal images often
    # ship with only C/POSIX/C.UTF-8 generated, causing noisy "cannot change locale" warnings
    # whenever /etc/default/locale (or LC_ALL) references en_US.UTF-8.
    if ! locale -a 2>/dev/null | grep -qix 'en_US\.utf-\?8'; then
        $WITH_SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y locales >/dev/null 2>&1 || true
        if command -v locale-gen >/dev/null 2>&1; then
            echo "generating en_US.UTF-8 locale" >&2
            $WITH_SUDO locale-gen en_US.UTF-8 >/dev/null 2>&1 || true
        fi
    fi
    # Profile-specific extras — best-effort. Each Ubuntu/Debian release has its quirks
    # (e.g., wslu missing from default repos on some Ubuntu versions); a single missing
    # extra shouldn't fail the whole bootstrap.
    local p ubuntu_major
    ubuntu_major="$(. /etc/os-release 2>/dev/null && echo "${VERSION_ID%%.*}")"
    for p in "${extra_pkgs[@]}"; do
        # wslu was deprecated for Ubuntu 26+ — gone from default repos AND the upstream PPA;
        # skip cleanly there (WSL has built-in interop now). On older Ubuntus the PPA is the fallback.
        if [ "$p" = "wslu" ] && [ "${ubuntu_major:-0}" -ge 26 ] 2>/dev/null; then
            echo "wslu deprecated for Ubuntu ${ubuntu_major}+; skipping (use built-in WSL interop)" >&2
            continue
        fi

        if dpkg -s "$p" >/dev/null 2>&1; then continue; fi
        if $WITH_SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y "$p"; then continue; fi

        # On older Ubuntus, wslu may live only in the upstream PPA; try it.
        if [ "$p" = "wslu" ]; then
            echo "wslu not in default repos; trying upstream PPA (ppa:wslutilities/wslu)" >&2
            $WITH_SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common >/dev/null 2>&1 || true
            if $WITH_SUDO add-apt-repository -y ppa:wslutilities/wslu >/dev/null 2>&1; then
                $WITH_SUDO apt-get update -qq 2>/dev/null || true
                if $WITH_SUDO DEBIAN_FRONTEND=noninteractive apt-get install -y wslu 2>/dev/null; then
                    continue
                fi
                # PPA didn't help — revert it so future apt-get update stays clean.
                echo "wslu PPA didn't help; removing PPA to keep apt clean" >&2
                $WITH_SUDO add-apt-repository -y --remove ppa:wslutilities/wslu >/dev/null 2>&1 || true
                $WITH_SUDO apt-get update -qq 2>/dev/null || true
            fi
        fi

        echo "WARNING: apt could not install '$p' (skipping; install manually if needed)" >&2
    done
}

# Returns 0 if any rpm in "$@" is NOT installed.
dnf_needs_install() {
    local p
    for p in "$@"; do
        rpm -q "$p" >/dev/null 2>&1 || return 0
    done
    return 1
}

install_dnf() {
    local common_pkgs=(
{{- range (index .dnf "common") }}
        "{{ . }}"
{{- end }}
    )
    local extra_pkgs=(
{{- range (index .dnf $.profile) }}
        "{{ . }}"
{{- end }}
    )
    if ! dnf_needs_install "${common_pkgs[@]}" "${extra_pkgs[@]}"; then
        echo "dnf: all packages already installed; skipping sudo dnf"
        return 0
    fi
    if [ -z "$WITH_SUDO" ] && [ "$(id -u)" -ne 0 ]; then
        echo "dnf: missing packages but no sudo available; skipping" >&2
        return 0
    fi
    # Common — strict.
    if dnf_needs_install "${common_pkgs[@]}"; then
        $WITH_SUDO dnf install -y "${common_pkgs[@]}"
    fi
    # Profile extras — best-effort.
    local p
    for p in "${extra_pkgs[@]}"; do
        if ! rpm -q "$p" >/dev/null 2>&1; then
            $WITH_SUDO dnf install -y "$p" || echo "WARNING: dnf could not install '$p'" >&2
        fi
    done
}
{{- end }}

# Skip system packages on embedded.
if [ "$PROFILE" = "embedded" ]; then
    echo "Profile=embedded: skipping system package install"
else
    case "$PKG_MGR" in
        apt) install_apt ;;
        dnf) install_dnf ;;
        apk) echo "alpine: see README for manual apk steps"; ;;
        *)   echo "WARNING: unknown package manager; install release binaries only" ;;
    esac
fi

# ---- Release binaries to ~/.local/bin (no sudo) ----
mkdir -p "$HOME/.local/bin"

ARCH="$(uname -m)"
case "$ARCH" in x86_64) ARCH_TAG="x86_64";; aarch64|arm64) ARCH_TAG="aarch64";; *) ARCH_TAG="$ARCH";; esac

# eza
EZA_VER="{{ index .release_binary "eza" }}"
if ! command -v eza >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/eza-community/eza/releases/download/v${EZA_VER}/eza_${ARCH_TAG}-unknown-linux-gnu.tar.gz" -o "$TMP/eza.tgz"
    tar -xzf "$TMP/eza.tgz" -C "$TMP"
    install -m 0755 "$TMP/eza" "$HOME/.local/bin/eza"
fi

# delta
DELTA_VER="{{ index .release_binary "delta" }}"
if ! command -v delta >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/dandavison/delta/releases/download/${DELTA_VER}/delta-${DELTA_VER}-${ARCH_TAG}-unknown-linux-gnu.tar.gz" -o "$TMP/delta.tgz"
    tar -xzf "$TMP/delta.tgz" -C "$TMP"
    install -m 0755 "$TMP/delta-${DELTA_VER}-${ARCH_TAG}-unknown-linux-gnu/delta" "$HOME/.local/bin/delta"
fi

# Neovim — current LazyVim requires >= 0.11.0.
# Release artifact name changed in 0.11: was nvim-linux64.tar.gz, now nvim-linux-x86_64.tar.gz.
{{- if ne .profile "embedded" }}
NVIM_VER="{{ index .release_binary "nvim" }}"
NVIM_INSTALLED_VER="$(nvim --version 2>/dev/null | head -1 | awk '{print $2}' | sed 's/^v//' || true)"
NVIM_INSTALLED_MINOR=0
if [ -n "$NVIM_INSTALLED_VER" ]; then
    NVIM_INSTALLED_MINOR="$(echo "$NVIM_INSTALLED_VER" | cut -d. -f2)"
fi
if [ "${NVIM_INSTALLED_MINOR:-0}" -lt 11 ] 2>/dev/null; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/neovim/neovim/releases/download/v${NVIM_VER}/nvim-linux-x86_64.tar.gz" -o "$TMP/nvim.tgz"
    tar -xzf "$TMP/nvim.tgz" -C "$TMP"
    NVIM_EXTRACTED="$(find "$TMP" -maxdepth 1 -type d -name 'nvim-linux*' | head -1)"
    rm -rf "$HOME/.local/share/nvim-runtime"
    mv "$NVIM_EXTRACTED" "$HOME/.local/share/nvim-runtime"
    ln -sfn "$HOME/.local/share/nvim-runtime/bin/nvim" "$HOME/.local/bin/nvim"
    # NOTE: an earlier version of this script extracted nvim INTO ~/.local/share/nvim/,
    # which is also nvim's XDG data dir (where lazy.nvim stores plugins). On affected boxes
    # the data dir now has stale bin/share/lib subtrees alongside the lazy/ plugin tree.
    # Manual cleanup (safe to run when nvim is closed):
    #   for d in bin share lib; do rm -rf ~/.local/share/nvim/$d; done
fi
{{- end }}

# fd (binary published as `fd` upstream; alias `fdfind` symlinked for Debian-muscle-memory).
FD_VER="{{ index .release_binary "fd" }}"
if ! command -v fd >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/sharkdp/fd/releases/download/v${FD_VER}/fd-v${FD_VER}-${ARCH_TAG}-unknown-linux-gnu.tar.gz" -o "$TMP/fd.tgz"
    tar -xzf "$TMP/fd.tgz" -C "$TMP"
    install -m 0755 "$TMP/fd-v${FD_VER}-${ARCH_TAG}-unknown-linux-gnu/fd" "$HOME/.local/bin/fd"
    ln -sfn "$HOME/.local/bin/fd" "$HOME/.local/bin/fdfind"
fi

# bat (`batcat` symlink for Debian-muscle-memory).
BAT_VER="{{ index .release_binary "bat" }}"
if ! command -v bat >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/sharkdp/bat/releases/download/v${BAT_VER}/bat-v${BAT_VER}-${ARCH_TAG}-unknown-linux-gnu.tar.gz" -o "$TMP/bat.tgz"
    tar -xzf "$TMP/bat.tgz" -C "$TMP"
    install -m 0755 "$TMP/bat-v${BAT_VER}-${ARCH_TAG}-unknown-linux-gnu/bat" "$HOME/.local/bin/bat"
    ln -sfn "$HOME/.local/bin/bat" "$HOME/.local/bin/batcat"
fi

# zoxide
ZOXIDE_VER="{{ index .release_binary "zoxide" }}"
if ! command -v zoxide >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/ajeetdsouza/zoxide/releases/download/v${ZOXIDE_VER}/zoxide-${ZOXIDE_VER}-${ARCH_TAG}-unknown-linux-musl.tar.gz" -o "$TMP/zoxide.tgz"
    tar -xzf "$TMP/zoxide.tgz" -C "$TMP"
    install -m 0755 "$TMP/zoxide" "$HOME/.local/bin/zoxide"
fi

# fzf
FZF_VER="{{ index .release_binary "fzf" }}"
if ! command -v fzf >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    # fzf's release archive uses linux_amd64 / linux_arm64 naming.
    case "$ARCH_TAG" in x86_64) FZF_ARCH="amd64";; aarch64) FZF_ARCH="arm64";; *) FZF_ARCH="$ARCH_TAG";; esac
    curl -fsSL "https://github.com/junegunn/fzf/releases/download/v${FZF_VER}/fzf-${FZF_VER}-linux_${FZF_ARCH}.tar.gz" -o "$TMP/fzf.tgz"
    tar -xzf "$TMP/fzf.tgz" -C "$TMP"
    install -m 0755 "$TMP/fzf" "$HOME/.local/bin/fzf"
fi

# keychain (single Perl script from upstream).
KEYCHAIN_VER="{{ index .release_binary "keychain" }}"
if ! command -v keychain >/dev/null 2>&1; then
    TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
    curl -fsSL "https://github.com/funtoo/keychain/archive/refs/tags/${KEYCHAIN_VER}.tar.gz" -o "$TMP/keychain.tgz"
    tar -xzf "$TMP/keychain.tgz" -C "$TMP"
    install -m 0755 "$TMP/keychain-${KEYCHAIN_VER}/keychain.sh" "$HOME/.local/bin/keychain"
fi

# starship
if ! command -v starship >/dev/null 2>&1; then
    curl -fsSL https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin"
fi

echo "package install complete (profile=$PROFILE, pkg_mgr=$PKG_MGR)"
