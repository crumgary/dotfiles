{{- if and (hasKey . "install_developer_tools") .install_developer_tools -}}
#!/usr/bin/env bash
# Explicit developer bundle, independent of the legacy install-every-agent flag.
# lock: {{ include "../config/tools.lock.json" | sha256sum }}
# installer: {{ include "../scripts/provision/tool_bundle.py" | sha256sum }}
# Python tools: {{ include "../scripts/provision/python_tools.py" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
python3 -B "{{ .chezmoi.sourceDir }}/../scripts/install-developer-tools" --apply
{{- end -}}
