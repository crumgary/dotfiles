# ~/.config/bash/90-wsl.sh — rendered only on profile=wsl

# Browser launcher (wslu's wslview hands URLs back to Windows).
if command -v wslview >/dev/null 2>&1; then
    export BROWSER=wslview
fi

# Windows VS Code's `code` command (so `code .` works from WSL).
{{- if .wsl_windows_username }}
VSCODE_BIN="/mnt/c/Users/{{ .wsl_windows_username }}/AppData/Local/Programs/Microsoft VS Code/bin"
if [ -d "$VSCODE_BIN" ]; then
    case ":$PATH:" in *":$VSCODE_BIN:"*) ;; *) PATH="$VSCODE_BIN:$PATH" ;; esac
    export PATH
fi
unset VSCODE_BIN
{{- end }}

# VS Code Remote Server CLI fallback — the `code` shim lives at a commit-hashed
# path that changes whenever VS Code Server updates. Append the newest one to
# PATH so `code .` still works when /mnt/c interop is broken (only effective
# while VS Code is open with this WSL workspace; cold-start needs the Windows
# shim above).
if [ -d "$HOME/.vscode-server/bin" ]; then
    VSCODE_REMOTE_CLI="$(ls -1dt "$HOME"/.vscode-server/bin/*/bin/remote-cli 2>/dev/null | head -n1)"
    if [ -n "$VSCODE_REMOTE_CLI" ] && [ -x "$VSCODE_REMOTE_CLI/code" ]; then
        case ":$PATH:" in *":$VSCODE_REMOTE_CLI:"*) ;; *) PATH="$PATH:$VSCODE_REMOTE_CLI" ;; esac
        export PATH
    fi
    unset VSCODE_REMOTE_CLI
fi

# Use Windows clipboard for OSC52-incapable terminals.
if command -v clip.exe >/dev/null 2>&1; then
    alias pbcopy='clip.exe'
fi
