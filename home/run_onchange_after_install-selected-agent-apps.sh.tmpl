{{- if and (hasKey . "agent_apps") .agent_apps -}}
#!/usr/bin/env bash
# Selected: {{ .agent_apps | toJson }}
# tools lock: {{ include "../config/tools.lock.json" | sha256sum }}
# installer: {{ include "../scripts/provision/agent_apps.py" | sha256sum }}
# adapters: {{ include "../scripts/provision/skill_adapters.py" | sha256sum }}
# RTK: {{ include "../scripts/provision/rtk_setup.py" | sha256sum }}
# shared skills: {{ include "../scripts/provision/shared_skills.py" | sha256sum }}
# runtime skills: {{ include "../scripts/provision/runtime_skills.py" | sha256sum }}
# memory: {{ include "../scripts/provision/memory_runtime.py" | sha256sum }}
# update owners: {{ include "../scripts/provision/update_owners.py" | sha256sum }}
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
python3 -B "{{ .chezmoi.sourceDir }}/../scripts/install-agent-apps" --apply --from-chezmoi
{{- end -}}
