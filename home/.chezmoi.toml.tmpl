{{- /* Init prompts — all machine-specific values live here, never in the repo */ -}}

{{- /* No fail-on-empty here — chezmoi init must always succeed so users can
       recover from a bad answer via `chezmoi init` or `chezmoi edit-config`.
       Empty values produce a one-time warning during apply (see
       run_onchange_after_check-identity.sh.tmpl). */ -}}
{{- $github_username := promptStringOnce . "github_username" "GitHub username (no default; e.g. crumgary)" -}}
{{- $git_user_name   := promptStringOnce . "git_user_name"   "Your full name for git commits (no default; e.g. Gary Crum)" -}}
{{- $git_user_email  := promptStringOnce . "git_user_email"  "Your email for git commits (no default)" -}}

{{- $profile := promptChoiceOnce . "profile" "Profile" (list "wsl" "devbox" "lab" "embedded") -}}
{{- $work    := promptBoolOnce   . "work"    "Is this a work machine? (true/false)" -}}

{{- $enable_ai_assistant := false -}}
{{- if ne $profile "embedded" -}}
  {{- $enable_ai_assistant = promptBoolOnce . "enable_ai_assistant" "Enable AI assistant in Neovim? (true/false)" -}}
{{- end -}}

{{- $wsl_windows_username := "" -}}
{{- if eq $profile "wsl" -}}
  {{- $wsl_windows_username = promptStringOnce . "wsl_windows_username" "Windows username (for /mnt/c/Users/<name>/ paths)" -}}
{{- end -}}

{{- /* Personal overlay (always available, regardless of work flag). */ -}}
{{- $bootstrap_priv_overlay := promptBoolOnce . "bootstrap_priv_overlay" "Clone the personal overlay repo (crumgary/dotfiles-priv)? (true/false)" -}}
{{- $priv_repo_url := "" -}}
{{- if $bootstrap_priv_overlay -}}
  {{- $priv_default_url := printf "git@github.com:%s/dotfiles-priv" $github_username -}}
  {{- $priv_repo_url = promptStringOnce . "priv_repo_url" (printf "Personal repo URL (default: %s)" $priv_default_url) -}}
  {{- if eq $priv_repo_url "" -}}{{- $priv_repo_url = $priv_default_url -}}{{- end -}}
{{- end -}}

{{- /* Work overlay (only on work machines). */ -}}
{{- $bootstrap_work_overlay := false -}}
{{- $work_repo_url          := "" -}}
{{- $internal_registries_exist := false -}}
{{- if $work -}}
  {{- $bootstrap_work_overlay = promptBoolOnce . "bootstrap_work_overlay" "Clone the work overlay repo (crumgary/dotfiles-work)? (true/false)" -}}
  {{- if $bootstrap_work_overlay -}}
    {{- $work_default_url := printf "git@github.com:%s/dotfiles-work" $github_username -}}
    {{- $work_repo_url = promptStringOnce . "work_repo_url" (printf "Work repo URL (default: %s)" $work_default_url) -}}
    {{- if eq $work_repo_url "" -}}{{- $work_repo_url = $work_default_url -}}{{- end -}}
  {{- end -}}
  {{- $internal_registries_exist = promptBoolOnce . "internal_registries_exist" "Does Voyager run internal npm/pip/cargo registries? (true/false)" -}}
{{- end -}}

{{- /* Convenience symlinks — mirror the real repo locations under one memorable dir. */ -}}
{{- $create_convenience_symlinks := promptBoolOnce . "create_convenience_symlinks" "Create convenience symlinks to your dotfile repos under one memorable dir? (true/false)" -}}
{{- $convenience_symlink_dir := "" -}}
{{- if $create_convenience_symlinks -}}
  {{- $conv_default := printf "%s/github/%s/dotfiles-src" .chezmoi.homeDir $github_username -}}
  {{- $convenience_symlink_dir = promptStringOnce . "convenience_symlink_dir" (printf "Directory for those shortcuts (default: %s)" $conv_default) -}}
  {{- if eq $convenience_symlink_dir "" -}}{{- $convenience_symlink_dir = $conv_default -}}{{- end -}}
{{- end -}}

[data]
    github_username           = {{ $github_username           | quote }}
    git_user_name             = {{ $git_user_name             | quote }}
    git_user_email            = {{ $git_user_email            | quote }}
    profile                   = {{ $profile                   | quote }}
    work                      = {{ $work }}
    enable_ai_assistant       = {{ $enable_ai_assistant }}
    wsl_windows_username      = {{ $wsl_windows_username      | quote }}
    bootstrap_priv_overlay    = {{ $bootstrap_priv_overlay }}
    priv_repo_url             = {{ $priv_repo_url             | quote }}
    bootstrap_work_overlay    = {{ $bootstrap_work_overlay }}
    work_repo_url             = {{ $work_repo_url             | quote }}
    internal_registries_exist = {{ $internal_registries_exist }}
    create_convenience_symlinks = {{ $create_convenience_symlinks }}
    convenience_symlink_dir     = {{ $convenience_symlink_dir     | quote }}
