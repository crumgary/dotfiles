{{- /* If name/email are empty, render with empty values rather than blocking apply.
       Git itself will error on `git commit` until they're set — which is the right place
       for that complaint, not here. A separate warning script flags this at apply time. */ -}}
[user]
    name  = {{ .git_user_name  }}
    email = {{ .git_user_email }}

[init]
    defaultBranch = main

[color]
    ui = auto

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate       = true
    line-numbers   = true
    side-by-side   = true

[pull]
    rebase = true

[rebase]
    autoStash    = true
    autosquash   = true

[merge]
    # zdiff3 requires git >= 2.35; diff3 is the safe baseline on Ubuntu 22.04 (git 2.34.x).
    conflictstyle = diff3

[diff]
    algorithm  = histogram
    colorMoved = zebra

[branch]
    sort = -committerdate

[column]
    ui = auto

[fetch]
    prune     = true
    pruneTags = true

[rerere]
    enabled = true

[commit]
    verbose = true

[push]
    autoSetupRemote = true

[help]
    autocorrect = prompt

[filter "lfs"]
    clean    = git-lfs clean -- %f
    smudge   = git-lfs smudge -- %f
    process  = git-lfs filter-process
    required = true

[credential "https://github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[core]
    excludesfile = ~/.gitignore_global

[include]
    path = ~/.config/git/aliases
{{- if ne .personal_git_email "" }}

# Directory-based identity override: repos physically under this gitdir prefix
# use the personal email from ~/.config/git/personal instead of the default above.
[includeIf "gitdir:{{ .personal_gitdir }}"]
    path = ~/.config/git/personal
{{- end }}

# Preserve historical safe.directory entries for Voyager work-trees.
[safe]
    directory = /home/gcrum/projects/narsil/sw-gc-yocto-nxp
    directory = /__w/openmct/openmct
