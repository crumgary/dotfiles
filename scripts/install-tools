#!/usr/bin/env -S python3 -B
"""Install selected development tools and their integrations."""

import sys

if sys.version_info < (3, 9):  # noqa: UP036 - guard users invoking an older system Python
    print("error: Python 3.9 or newer is required.", file=sys.stderr)
    sys.exit(2)
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from provision.install_tools import main

if __name__ == "__main__":
    sys.exit(main())
